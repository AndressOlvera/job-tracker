# Plantilla de variables de entorno para desarrollo local.
# Cópiala como .env (cp .env.example .env) y ajústala si hace falta.
# El archivo .env NO se sube a Git; este .env.example sí, como referencia.

# ---------- PostgreSQL en Docker (lo lee docker-compose.yml) ----------
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=jobtracker
POSTGRES_DB=jobtracker
# Cambia el puerto si ya tienes otro PostgreSQL usando el 5432,
# y ajústalo también en las dos URL de abajo.
POSTGRES_PORT=5432
# La contraseña también va dentro de las URL de conexión: evita los caracteres
# @ : / ? # porque tienen un significado especial en una URL.

# ---------- Toda la app en Docker (docker compose up) ----------
# Puerto de tu computadora donde se abre la app: http://localhost:8080
WEB_PORT=8080
# Dentro de Docker, la API arma su propia DATABASE_URL apuntando al servicio
# "db" (ver docker-compose.yml); la de abajo es para `flask run` y pytest.

# ---------- API Flask (la leen Flask y pytest) ----------
# development | testing | production
APP_ENV=development
DATABASE_URL=postgresql+psycopg://jobtracker:jobtracker@localhost:5432/jobtracker
TEST_DATABASE_URL=postgresql+psycopg://jobtracker:jobtracker@localhost:5432/jobtracker_test
# Zona horaria para calcular "hoy" (fecha por defecto y validación de fechas futuras)
APP_TIMEZONE=America/Mexico_City
